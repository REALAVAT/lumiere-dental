# Public URL of the deployed site, used for canonical URLs, hreflang, sitemap, Open Graph and JSON-LD.
# Optional on Vercel: falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=https://lumiere-dental.vercel.app

# Booking and contact emails via Resend (https://resend.com).
# Leave RESEND_API_KEY empty to run in demo mode: forms succeed and the payload is logged on the server.
RESEND_API_KEY=
# Where notifications are sent. Comma-separate multiple addresses.
BOOKING_EMAIL_TO=
# Verified sender. Defaults to Resend's onboarding sender, which only delivers to your own Resend account email.
RESEND_FROM="Lumière Dental <bookings@yourdomain.com>"
